# Required — the app calls Supabase directly (lib/supabase.ts) and will
# throw on startup if these are missing.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Required for the map + address search (components/AppMap*, app/location-picker.tsx).
# One Google Cloud API key with these APIs enabled:
#   Maps SDK for Android, Maps SDK for iOS, Maps JavaScript API,
#   Places API (New), Geocoding API
# Restrict it: HTTP referrers for web, Android package + SHA-1, iOS bundle id.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# The customer "AI Help" photo analysis (app/ai-assistant.tsx) runs in the
# `ai-analyze` Supabase Edge Function, NOT the app bundle. Its key is a Supabase
# secret, not an env var here:
#   supabase secrets set GEMINI_API_KEY=...   (free: https://aistudio.google.com/apikey)
#   supabase functions deploy ai-analyze
# Until then the screen falls back to "Post a Job Manually".
