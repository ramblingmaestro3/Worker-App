# Required for the map + address search (components/AppMap*, app/location-picker.tsx).
# One Google Cloud API key with these APIs enabled:
#   Maps SDK for Android, Maps SDK for iOS, Maps JavaScript API,
#   Places API (New), Geocoding API
# Restrict it: HTTP referrers for web, Android package + SHA-1, iOS bundle id.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# The customer "AI Help" photo analysis (screens/common/AiAssistant.tsx) runs in
# the `ai-analyze` Supabase Edge Function, NOT the app bundle. Its key is a
# Supabase secret, not an env var here:
#   supabase secrets set OPENROUTER_API_KEY=...   (https://openrouter.ai/keys)
#   supabase functions deploy ai-analyze
# Until then the screen falls back to "Post a Job Manually".
