# Required — the app calls Supabase directly (lib/supabase.ts) and will
# throw on startup if these are missing.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Legacy — only used by the Flask REST client (lib/api.ts) and the screens
# still wired to it (login.tsx, register.tsx, worker-home.tsx, etc.), not
# by the live Supabase-based app flow.
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api
