# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/workerapp_db
# Alternative for MySQL: mysql+pymysql://username:password@localhost:3306/workerapp_db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:19006,http://10.0.2.2:19006

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# File Upload Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf

# Payment Integration (Stripe)
STRIPE_PUBLIC_KEY=your-stripe-public-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# SMS Integration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password

# Application Configuration
APP_NAME=AdwumaGo
APP_VERSION=1.0.0
APP_URL=http://localhost:5000

# Emergency Service Configuration
EMERGENCY_SERVICE_ENABLED=True
EMERGENCY_SERVICE_SURCHARGE=0.5

# AI Matching Configuration
AI_MATCHING_ENABLED=True
AI_MATCHING_THRESHOLD=0.7

# AI Vision Configuration (Google Gemini / Google AI Studio) — used by the customer "AI Help" photo analysis feature
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.5-flash
AI_VISION_MAX_IMAGE_BYTES=8388608
